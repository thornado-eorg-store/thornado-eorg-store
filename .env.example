# Copia este archivo como .env (en web/) y ajusta los valores

# Base de datos (Postgres local vía docker-compose.yml)
DATABASE_URL="postgresql://tienda:tienda_dev@localhost:5432/tienda_musica?schema=public"

# Storage S3-compatible (MinIO local o Cloudflare R2 en producción)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="miniodev"
S3_SECRET_KEY="miniodev123"
S3_BUCKET_PRIVATE="masters"     # lossless privado, entrega por URLs firmadas
S3_BUCKET_PUBLIC="previews"     # previews y portadas vía CDN

# Pagos (fase de integración)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_CONNECT_WEBHOOK_SECRET=""

# Modo edición (panel /estudio — acceso de mantenimiento)
ESTUDIO_PASSWORD=""  # sin esto se usa la provisional "thornado-2026"; cámbiala antes de publicar

# Email transaccional
RESEND_API_KEY=""

# Config de la plataforma
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
PLATFORM_FEE_DIGITAL="0.10"    # 10% digital
PLATFORM_FEE_PHYSICAL="0.07"   # 7% físico
PLATFORM_FEE_BEATS="0.08"      # 8% beats/licencias
